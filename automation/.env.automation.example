# Copy to .env.automation and fill in. NEVER commit .env.automation.
# (.gitignore already excludes it.)

# --- Claude Code auth (pick ONE) ---
# Preferred: subscription token. Run `claude setup-token` on your host and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# OR use an Anthropic API key (console billing) instead of the token above:
# ANTHROPIC_API_KEY=

# --- GitHub (git push + gh pr create) ---
# Fine-grained PAT with Contents + Pull requests: write on the pool-ai repo.
GH_TOKEN=

# --- Jira REST ---
JIRA_BASE_URL=https://gabrielsworkspace-39397538.atlassian.net
JIRA_HOST=gabrielsworkspace-39397538.atlassian.net
JIRA_EMAIL=gabrielyassunaga98@gmail.com
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Project runtime (so manage.py check / graph calls work) ---
OPENROUTER_API_KEY=

# Optional: extra egress hosts the firewall should allow (comma-separated)
EXTRA_ALLOWED_HOSTS=
