OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # default, override if needed
# Áudio do WhatsApp é transcrito por um modelo multimodal (Claude não aceita áudio).
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.0-flash-001
# Imagem é interpretada por visão; vazio = reusa OPENROUTER_MODEL (Claude já aceita imagem).
# OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4-6

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=Local
# Número (WhatsApp) avisado quando um lead pede atendimento humano. Vazio = sem aviso.
HANDOFF_NOTIFY_NUMBER=
# Token do webhook (URL do webhook na Evolution deve incluir ?token=<valor>). Vazio = sem checagem.
EVOLUTION_WEBHOOK_TOKEN=
# "digitando..." dura len(texto) * N ms antes de entregar cada mensagem (0 desliga).
# ~30ms/char ≈ digitação humana; suba/baixe a gosto.
EVOLUTION_TYPING_MS_PER_CHAR=30

# Debounce de mensagens (agrupa rajadas num só turno). Reusa o Redis da Evolution
# no DB index 1. DEBOUNCE_SECONDS = janela de espera após a última mensagem.
REDIS_URL=redis://localhost:6379/1
DEBOUNCE_SECONDS=8
