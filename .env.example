OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # default, override if needed

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=Local
# Comma-separated numbers the bot may reply to. Empty = reply to anyone.
EVOLUTION_ALLOWED_NUMBERS=
# "digitando..." dura len(texto) * N ms antes de entregar cada mensagem (0 desliga).
# ~30ms/char ≈ digitação humana; suba/baixe a gosto.
EVOLUTION_TYPING_MS_PER_CHAR=30

# Debounce de mensagens (agrupa rajadas num só turno). Reusa o Redis da Evolution
# no DB index 1. DEBOUNCE_SECONDS = janela de espera após a última mensagem.
REDIS_URL=redis://localhost:6379/1
DEBOUNCE_SECONDS=8
